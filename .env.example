# Sao chép file này thành  .env  rồi điền khóa thật vào.
#   PowerShell:  Copy-Item .env.example .env
#
# ── ORS_API_KEY — khóa OpenRouteService, miễn phí ──
#   1. Vào https://openrouteservice.org  →  Sign up (email bất kỳ)
#   2. Đăng nhập  →  Dashboard  →  "Request a token"
#   3. Token type: Standard  →  đặt tên tùy ý  →  CREATE TOKEN
#   4. Sao chép chuỗi dài vừa hiện ra, dán vào dòng dưới
#   Hạn mức miễn phí: 2.000 lượt gọi/ngày, 40 lượt/phút — thừa cho demo.
#
# ── SUPABASE_URL / SUPABASE_ANON_KEY — kho sự cố chung ──
#   Supabase Dashboard → dự án của bạn → Settings → API
#   SUPABASE_URL       = "Project URL"
#   SUPABASE_ANON_KEY   = khóa "anon public" (KHÔNG dùng khóa service_role)
#   Nhớ đặt "supabase.bat": true trong kich_ban.json để bật gửi sự cố lên cloud.
#
# File .env đã được .gitignore bỏ qua, không lo lộ khóa.

ORS_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
