# Khóa API — KHÔNG BAO GIỜ đưa lên GitHub
.env

# Môi trường ảo Python
.venv/
__pycache__/
*.pyc

# Video người dùng tải lên khi chạy demo
uploads/*
!uploads/.gitkeep

# Model — bỏ qua mọi file .pt, TRỪ best.pt (model tự train, ~5 MB, đưa lên GitHub
# để clone về là chạy được ngay). yolo11n.pt không cần — Ultralytics tự tải.
*.pt
!best.pt
!models/**/best.pt

# Kết quả chạy thử của Ultralytics
runs/

# Cau hinh cuc bo cua Claude Code — rieng tung may
.claude/
